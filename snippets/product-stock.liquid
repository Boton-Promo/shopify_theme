<ap-inventoryproduct form-id="ap-productform-{{ section.id }}-{{ product.id }}" class="ap-productform__inventory-wrapper">
    <span class="inventory">
        {% if product.variants[0]["available"] %}
            <span class="inventory_stock">
                {{ 'products.product.in_stock' | t }} - {{ product.variants[0].inventory_quantity }} disponibles
            </span>
        {% else %}
            <span class="inventory_outstock">
                {{ 'products.product.out_stock' | t }}
            </span>
        {% endif %}
    </span>
    <script type="application/json">
        {
            {%- assign _size = product.variants | size -%}
            {%- for variant in product.variants -%}
                "{{ variant.id }}": {
                    "available": {{ variant.available }},
                    "inventory_quantity": {{ variant.inventory_quantity }}
                }
                {%- if forloop.index < _size and _size > 1 -%},{%- endif -%}
            {%- endfor -%}
        }
    </script>
</ap-inventoryproduct>
