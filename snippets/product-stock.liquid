<ap-inventoryproduct form-id="ap-productform-{{ section.id }}-{{ product.id }}" class="ap-productform__inventory-wrapper">
    <span id="inventory-display" class="inventory">
        {% if product.selected_or_first_available_variant.available %}
            Stock: {{ product.selected_or_first_available_variant.inventory_quantity }}
        {% else %}
            Out of Stock
        {% endif %}
    </span>
</ap-inventoryproduct>



<script>
document.addEventListener("DOMContentLoaded", function() {
    const variantSelect = document.getElementById("product-select-{{ section.id }}-{{ product.id }}");
    const inventoryDisplay = document.getElementById("inventory-display");

    // Función para obtener inventario y actualizar el DOM
    const updateInventory = (selectedVariant) => {
        const inventoryQuantity = selectedVariant.getAttribute("data-inventory-quantity");

        // Limpiar el contenido actual del inventario
        inventoryDisplay.textContent = ""; // Limpia completamente el contenido

        // Actualizar el inventario mostrado
        if (parseInt(inventoryQuantity) > 0) {
            inventoryDisplay.textContent = `Stock: ${inventoryQuantity}`;
        } else {
            inventoryDisplay.textContent = "Out of Stock";
        }
    };

    // Llamar a la función al cargar la página para inicializar el valor del inventario
    const initialSelectedVariant = variantSelect.options[variantSelect.selectedIndex];
    updateInventory(initialSelectedVariant);

    // Actualiza el inventario al cambiar la variante
    variantSelect.addEventListener("change", function() {
        const selectedVariant = variantSelect.options[variantSelect.selectedIndex];
        updateInventory(selectedVariant);
    });
});



</script>
