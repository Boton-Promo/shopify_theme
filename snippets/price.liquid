{% assign variant = product.selected_or_first_available_variant %}
{% if customer %}
<div class="ap-productmeta__price-list-container" role="region" aria-live="polite">
  <div class="price-list" data-product-price-list="">
  <span class="price price--highlight price--large">
    {%- if variant.compare_at_price > variant.price -%}
      <span class="price">
        <span class="visually-hidden">Sale price</span>
        {{ variant.price | money }} {%- if variant.taxable -%}{%- endif -%}+IVA
      </span>
      <span class="price price--compare">
        <span class="visually-hidden">Regular price</span>
        {{ variant.compare_at_price | money }} +IVA
      </span>
    {%- else -%}
      <span class="price">
        <span class="visually-hidden">Regular price</span>
        {{ variant.price | money }} +IVA{%- if variant.taxable -%}{%- endif -%}
      </span>
    {%- endif -%}
  </span>
</div>


 

  <div class="ap-productmeta__label-list label-list" data-product-label-list="">
    {%- if variant.available == false -%}
      <span class="label label--subdued">Agotado</span>
    {%- endif -%}
    {%- if variant.compare_at_price > variant.price -%}
      {% assign discount = variant.compare_at_price | minus: variant.price %}
    <!-- <span class="label label--highlight">Ahorra {{ discount | money }}</span> -->
    {% endif %}
  </div>
</div>
{% endif %}


