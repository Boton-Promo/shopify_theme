/* ═══════════════════════════════════════════════════════
   UTILIDADES COMPARTIDAS
═══════════════════════════════════════════════════════ */

/* Crear bat volando */
function createFlyingBat(container){
  const fromLeft = Math.random() > .5;
  const yPct  = Math.random()*38 + 3;
  const dur   = (Math.random()*8+10).toFixed(1);
  const sz    = Math.random()*22+28;
  const el    = document.createElement('div');
  el.className = 'hw-bat';
  el.style.cssText =
    `top:${yPct}%;`+
    (fromLeft ? 'left:-80px;' : 'right:-80px;')+
    `width:${sz}px;height:${(sz*.55).toFixed(0)}px;`+
    `animation-name:${fromLeft ? 'hwBatFly' : 'hwBatFlyR'};`+
    `animation-duration:${dur}s;`+
    (fromLeft ? '' : 'transform:scaleX(-1);')+
    `filter:drop-shadow(0 0 4px rgba(139,0,255,.5));`;
  el.innerHTML = BAT_SVG;
  container.appendChild(el);
  setTimeout(() => el.remove(), dur*1000+500);
}

/* Spawner de dementor genérico */
function spawnDementor(container, active){
  if(!active.on) return;
  const fromLeft = Math.random() > .5;
  const size = Math.random()*36 + 42; // 42–78 px
  const dur  = Math.random()*10 + 10;
  const sy   = ((Math.random()*50-25)).toFixed(0)+'px';
  const wrap = document.createElement('div');
  wrap.style.cssText =
    `position:absolute;top:${Math.random()*58+4}%;`+
    (fromLeft ? 'left:-130px;' : 'right:-130px;')+
    `animation:${fromLeft?'haDlr':'haDrl'} ${dur}s ease-in-out forwards;`+
    `--sy:${sy};opacity:.65;`+
    `filter:drop-shadow(0 0 6px #4B0082) drop-shadow(0 0 12px rgba(155,0,255,.2));`;
  wrap.innerHTML = `<div style="width:${size}px;height:${(size*1.6).toFixed(0)}px">${DEMENTOR_SVG}</div>`;
  container.appendChild(wrap);
  setTimeout(() => wrap.remove(), dur*1000+300);
  const next = Math.random()*5000 + 6000;
  setTimeout(() => spawnDementor(container, active), next);
}

/* Cursor trail (collection + product) */
function buildCursorTrail(parent){
  const EMOJIS = ['💀','🎃','👻','🕷️','🦇'];
  const LEN = 12;
  const dots = [];
  for(let i=0;i<LEN;i++){
    const el = document.createElement('div');
    el.className = 'hw-trail';
    el.textContent = EMOJIS[i % EMOJIS.length];
    const base = 1 - i/LEN;
    el.style.cssText = `font-size:${(base*15+6).toFixed(0)}px;opacity:0;`;
    parent.appendChild(el);
    dots.push({el, x:-300, y:-300});
  }
  let mX=-300, mY=-300;
  document.addEventListener('mousemove', e=>{mX=e.clientX; mY=e.clientY;});
  function loop(){
    let px=mX, py=mY;
    dots.forEach((d,i)=>{
      d.x += (px-d.x)*.35;
      d.y += (py-d.y)*.35;
      const op = Math.max(0,(1-i/LEN)*.9);
      const sc = 1-i/LEN*.4;
      d.el.style.transform = `translate(${d.x}px,${d.y}px) scale(${sc.toFixed(2)}) translate(-50%,-50%)`;
      d.el.style.opacity = op.toFixed(2);
      px=d.x; py=d.y;
    });
    requestAnimationFrame(loop);
  }
  loop();
}

/* Fantasma en click (collection + product) */
function buildClickGhost(parent){
  const EMOJIS = ['👻','💀','🎃','👁️','🦇','💀'];
  const MSGS   = ['¡BOO!','¡HALLOWEEN!','¡RIP! 💀','¡ÜÜÜ!','¡CUIDADO!','¡UY!'];
  let idx = 0;
  document.addEventListener('click', e=>{
    if(e.target.closest('a,button,input,select,textarea,[role=button]')) return;
    const pop = document.createElement('div');
    pop.className = 'hw-ghost-pop';
    pop.style.left = (e.clientX-25)+'px';
    pop.style.top  = (e.clientY-20)+'px';
    pop.innerHTML  =
      `<span class="hw-ghost-svg">${EMOJIS[idx%EMOJIS.length]}</span>`+
      `<span class="hw-ghost-txt">${MSGS[idx%MSGS.length]}</span>`;
    idx++;
    parent.appendChild(pop);
    setTimeout(() => pop.remove(), 1900);
