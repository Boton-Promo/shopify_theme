<div id="nv-snow-wrap" style="position:fixed;inset:0;pointer-events:none;"></div>
<div id="nv-layer" style="position:fixed;inset:0;pointer-events:none;overflow:hidden;"></div>

<div id="nv-count" style="display:none">
  <button type="button" id="nv-x" aria-label="Cerrar contador">&times;</button>
  <div class="nv-ico">🎅🦌</div>
  <div class="nv-body">
    <div class="nv-lbl" id="nv-lbl">Faltan</div>
    <div class="nv-days"><span id="nv-d">0</span><small id="nv-u">días</small></div>
    <div class="nv-sub" id="nv-sub">para Navidad 🎄</div>
    <div class="nv-clock" id="nv-clock">Próximo día en <b id="nv-t">00:00:00</b></div>
  </div>
</div>

<style>
/* ─── CONTADOR ─────────────────────────────────────── */
#nv-count{
  position:fixed;left:50%;bottom:14px;transform:translateX(-50%);
  z-index:99992;display:flex;align-items:center;gap:10px;
  background:linear-gradient(135deg,#0b3d2e,#145a43);
  border:2px solid #d4a017;border-radius:16px;padding:8px 16px 8px 12px;
  color:#fff;font-family:'Segoe UI',Arial,sans-serif;
  box-shadow:0 6px 22px rgba(0,0,0,.35),0 0 14px rgba(212,160,23,.35);
  animation:nvPop .6s cubic-bezier(.2,1.4,.4,1);
}
#nv-count .nv-ico{font-size:26px;line-height:1}
#nv-count .nv-body{line-height:1.1;text-align:left}
#nv-count .nv-lbl{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#ffd34d;font-weight:700}
#nv-count .nv-days{font-size:30px;font-weight:900;color:#fff;display:flex;align-items:baseline;gap:5px}
#nv-count .nv-days small{font-size:13px;font-weight:700;color:#ffd34d}
#nv-count .nv-sub{font-size:11px;color:#cfeee0;font-weight:600}
#nv-count .nv-clock{font-size:10px;color:#9fd8bf;margin-top:2px}
#nv-count .nv-clock b{color:#fff;font-variant-numeric:tabular-nums}
#nv-x{
  position:absolute;top:-9px;right:-9px;width:22px;height:22px;border-radius:50%;
  border:2px solid #d4a017;background:#c8102e;color:#fff;font-size:14px;line-height:1;
  cursor:pointer;padding:0;display:flex;align-items:center;justify-content:center;
}
@keyframes nvPop{0%{transform:translateX(-50%) scale(.6);opacity:0}100%{transform:translateX(-50%) scale(1);opacity:1}}

/* ─── TRINEO ───────────────────────────────────────── */
.nv-sleigh{
  position:fixed;left:0;display:flex;align-items:center;pointer-events:none;
  animation:nvFly linear forwards;will-change:transform;
}
.nv-bob{display:flex;align-items:center;animation:nvBob 1.4s ease-in-out infinite}
.nv-banner{
  position:relative;margin-right:26px;background:#fffdf5;border:2px solid #c8102e;
  color:#c8102e;font:800 15px 'Segoe UI',Arial,sans-serif;padding:6px 14px;
  border-radius:4px;white-space:nowrap;transform-origin:right center;
  box-shadow:0 3px 10px rgba(0,0,0,.2);animation:nvFlap 1.1s ease-in-out infinite alternate;
}
.nv-banner::after{content:'';position:absolute;right:-26px;top:50%;width:26px;height:2px;background:#b8860b}
.nv-banner::before{content:'';position:absolute;inset:3px;border:1px dashed rgba(200,16,46,.35);border-radius:2px}
.nv-sleigh svg{display:block;overflow:visible}
.nv-leg{transform-box:fill-box;transform-origin:50% 0;animation:nvLeg .45s ease-in-out infinite alternate}
.nv-leg.b{animation-delay:.22s}
.nv-nose{animation:nvGlow 1s ease-in-out infinite alternate}
@keyframes nvFly{from{transform:translateX(-115%)}to{transform:translateX(100vw)}}
@keyframes nvBob{0%,100%{transform:translateY(0) rotate(-1.5deg)}50%{transform:translateY(-10px) rotate(1.5deg)}}
@keyframes nvFlap{from{transform:skewY(-3deg)}to{transform:skewY(3deg)}}
@keyframes nvLeg{from{transform:rotate(-20deg)}to{transform:rotate(20deg)}}
@keyframes nvGlow{from{filter:drop-shadow(0 0 2px #ff2a2a)}to{filter:drop-shadow(0 0 9px #ff2a2a)}}

/* ─── ESTELA DEL PUNTERO ───────────────────────────── */
.nv-t{position:fixed;left:0;top:0;pointer-events:none;z-index:99998;user-select:none;line-height:1;will-change:transform}

/* ─── MENSAJE AL CLICK ─────────────────────────────── */
.nv-pop{
  position:fixed;pointer-events:none;z-index:99999;text-align:center;user-select:none;
  white-space:nowrap;animation:nvPopUp 1.9s ease-out forwards;
}
.nv-pop i{font-style:normal;font-size:40px;display:block;filter:drop-shadow(0 2px 4px rgba(0,0,0,.3))}
.nv-pop b{
  display:block;margin-top:3px;font:900 15px Impact,'Arial Black',sans-serif;letter-spacing:1px;
  color:#c8102e;text-shadow:0 0 3px #fff,0 0 3px #fff,0 0 8px #fff,0 0 12px rgba(212,160,23,.9);
}
.nv-pop b.g{color:#0b6b43}
@keyframes nvPopUp{
  0%{transform:translateY(0) scale(.4);opacity:0}
  15%{transform:translateY(-14px) scale(1.15);opacity:1}
  60%{opacity:1}
  100%{transform:translateY(-120px) scale(.9);opacity:0}
}

/* ─── MÓVIL ────────────────────────────────────────── */
@media(max-width:600px){
  #nv-count{padding:6px 12px 6px 8px;bottom:10px}
  #nv-count .nv-days{font-size:24px}
  #nv-count .nv-ico{font-size:20px}
  .nv-banner{font-size:12px;padding:4px 10px}
  .nv-sleigh svg{width:210px;height:auto}
}

/* ─── PRODUCTO: imágenes por encima de las animaciones ─ */
body.template-product .product__media-wrapper,
body.template-product .product-single__media,
body.template-product .product-media-container,
body.template-product .product__media-item,
body.template-product .product__media,
body.template-product .product-photo-container,
body.template-product .product-img-wrapper,
body.template-product [data-product-media-type-image],
body.template-product .product__thumbnail-item,
body.template-product .product__thumbnails,
body.template-product .product-gallery,
body.template-product .product__media-list,
body.template-product .productView-image,
body.template-product .product-featured-img{position:relative;z-index:10}
</style>

<script>
(function(){
'use strict';

const CFG = {
  from:  [11, 1],
  until: [12, 26],
  FORCE_ON: true,       /* Forzado en true para que aparezca de inmediato */
  sleighFirst: 2500,
  sleighEvery: 28000,
  sleighDur: 15
};

const nowD = new Date();
const md   = (nowD.getMonth()+1)*100 + nowD.getDate();
const inRange = md >= CFG.from[0]*100+CFG.from[1] && md <= CFG.until[0]*100+CFG.until[1];
if(!CFG.FORCE_ON && !inRange) return;

const IS_PROD  = document.body.classList.contains('template-product') || /\/products\//.test(location.pathname);
const IS_TOUCH = window.matchMedia('(pointer:coarse)').matches;
const REDUCED  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const Z_BG     = IS_PROD ? 2 : 99990;
const layer    = document.getElementById('nv-layer');
if(layer) layer.style.zIndex = Z_BG;

if(IS_PROD){
  const sel=['.product__media-wrapper','.product__media','.product-photo-container',
    '.product-img-wrapper','[data-product-media-type-image]','.product__thumbnails',
    '.product-gallery','.product__media-list'].join(',');
  const up=()=>document.querySelectorAll(sel).forEach(e=>{e.style.position='relative';e.style.zIndex='10';});
  up(); document.addEventListener('DOMContentLoaded',up);
}

function pad(n){return String(n).padStart(2,'0');}
function calc(){
  const n = new Date();
  const today = new Date(n.getFullYear(), n.getMonth(), n.getDate());
  let target = new Date(n.getFullYear(), 11, 25);
  if(today > target) target = new Date(n.getFullYear()+1, 11, 25);
  const days = Math.round((target - today)/864e5);
  const nextMidnight = new Date(n.getFullYear(), n.getMonth(), n.getDate()+1);
  const s = Math.max(0, Math.floor((nextMidnight - n)/1000));
  return {days, clock: pad(Math.floor(s/3600))+':'+pad(Math.floor(s%3600/60))+':'+pad(s%60)};
}
function bannerText(d){
  if(d===0) return '🎄 ¡Feliz Navidad! 🎅';
  if(d===1) return '🎄 ¡Mañana es Navidad! 🎁';
  return '🎄 Faltan '+d+' días para Navidad 🎁';
}

const box = document.getElementById('nv-count');
let closed = false;
try{ closed = sessionStorage.getItem('nvClosed')==='1'; }catch(e){}
if(!closed && box) box.style.display='flex';
const closeBtn = document.getElementById('nv-x');
if(closeBtn){
  closeBtn.addEventListener('click',()=>{
    if(box) box.style.display='none';
    try{ sessionStorage.setItem('nvClosed','1'); }catch(e){}
  });
}

function tick(){
  const c = calc();
  const d = document.getElementById('nv-d'), u = document.getElementById('nv-u'),
        l = document.getElementById('nv-lbl'), s = document.getElementById('nv-sub'),
        k = document.getElementById('nv-clock'), t = document.getElementById('nv-t');
  if(!d) return;
  if(c.days===0){
    l.textContent='¡Hoy es!'; d.textContent='25'; u.textContent='dic';
    s.textContent='¡Feliz Navidad! 🎄'; if(k) k.style.display='none';
  } else {
    l.textContent = c.days===1 ? 'Falta' : 'Faltan';
    d.textContent = c.days;
    u.textContent = c.days===1 ? 'día' : 'días';
    s.textContent = 'para Navidad 🎄';
    if(k) k.style.display='block';
    if(t) t.textContent = c.clock;
  }
}
tick(); setInterval(tick,1000);

const snowWrap = document.getElementById('nv-snow-wrap');
if(snowWrap){
  const cv = document.createElement('canvas');
  cv.style.cssText='position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:'+Z_BG+';';
  snowWrap.appendChild(cv);
  const ctx = cv.getContext('2d');
  let W=0,H=0;
  function resize(){W=cv.width=window.innerWidth;H=cv.height=window.innerHeight;}
  resize(); window.addEventListener('resize',resize);

  const COUNT = REDUCED ? 25 : (IS_TOUCH ? 45 : 90);
  const flakes = Array.from({length:COUNT},()=>({
    x:Math.random()*window.innerWidth, y:Math.random()*window.innerHeight,
    r:Math.random()*3+1.2, v:Math.random()*1.1+.5,
    ph:Math.random()*6.28, sw:Math.random()*.9+.3,
    glyph: Math.random()<.1, gs: Math.random()*8+12
  }));
  let mX = window.innerWidth/2;
  document.addEventListener('mousemove',e=>{mX=e.clientX;},{passive:true});

  function snow(){
    ctx.clearRect(0,0,W,H);
    const wind = (mX/W-.5)*1.6;
    ctx.shadowColor='rgba(90,150,220,.65)'; ctx.shadowBlur=4;
    for(const f of flakes){
      f.ph += .015;
      f.y += f.v;
      f.x += Math.sin(f.ph)*f.sw + wind*f.v;
      if(f.y>H+10){f.y=-10;f.x=Math.random()*W;}
      if(f.x>W+10)f.x=-10; else if(f.x<-10)f.x=W+10;
      if(f.glyph){
        ctx.font=f.gs+'px serif'; ctx.fillStyle='#8cc4f2';
        ctx.fillText('❄',f.x,f.y);
      } else {
        ctx.fillStyle='rgba(255,255,255,.96)';
        ctx.beginPath(); ctx.arc(f.x,f.y,f.r,0,6.283); ctx.fill();
      }
    }
    requestAnimationFrame(snow);
  }
  snow();
}

const SLEIGH_SVG = `
<svg viewBox="0 0 300 110" width="300" height="110" xmlns="http://www.w3.org/2000/svg">
  <path d="M100 58 Q160 48 214 58" stroke="#b8860b" stroke-width="2" fill="none"/>
  <path d="M22 62 Q18 90 42 92 L120 92 Q142 90 140 66 Z" fill="#c8102e"/>
  <path d="M28 70 L134 70" stroke="#ffd34d" stroke-width="3"/>
  <path d="M14 100 Q62 108 132 100 Q150 98 152 84" stroke="#d4a017" stroke-width="4" fill="none" stroke-linecap="round"/>
  <line x1="50" y1="92" x2="50" y2="101" stroke="#d4a017" stroke-width="3"/>
  <line x1="110" y1="92" x2="110" y2="101" stroke="#d4a017" stroke-width="3"/>
  <ellipse cx="44" cy="54" rx="18" ry="20" fill="#8d5524"/>
  <path d="M36 38 Q44 30 52 38" fill="#6b3f17"/>
  <rect x="38" y="48" width="12" height="10" fill="#2f9e6a"/><line x1="44" y1="48" x2="44" y2="58" stroke="#ffd34d" stroke-width="2"/>
  <ellipse cx="94" cy="66" rx="17" ry="15" fill="#d61f3c"/>
  <rect x="78" y="70" width="32" height="5" fill="#222"/><rect x="90" y="69" width="8" height="7" fill="#ffd34d"/>
  <circle cx="94" cy="42" r="11" fill="#f5cba7"/>
  <path d="M83 44 Q94 66 105 44 Q94 51 83 44Z" fill="#fff"/>
  <circle cx="90" cy="40" r="1.4" fill="#222"/><circle cx="98" cy="40" r="1.4" fill="#222"/>
  <circle cx="94" cy="44" r="2" fill="#e89a8a"/>
  <path d="M82 36 Q94 6 108 32 L106 38 Q94 31 84 38Z" fill="#d61f3c"/>
  <rect x="81" y="35" width="28" height="6" rx="3" fill="#fff"/>
  <circle cx="110" cy="29" r="5" fill="#fff"/>
  <path d="M106 62 Q122 56 128 46" stroke="#d61f3c" stroke-width="6" fill="none" stroke-linecap="round"/>
  <circle cx="129" cy="44" r="4" fill="#fff"/>
  <g>
    <path d="M214 56 Q205 52 200 56" stroke="#8b5a2b" stroke-width="4" fill="none" stroke-linecap="round"/>
    <g class="nv-leg"><line x1="206" y1="72" x2="203" y2="98" stroke="#5c3a1a" stroke-width="4.5" stroke-linecap="round"/></g>
    <g class="nv-leg b"><line x1="217" y1="73" x2="217" y2="98" stroke="#5c3a1a" stroke-width="4.5" stroke-linecap="round"/></g>
    <ellipse cx="226" cy="62" rx="27" ry="14" fill="#8b5a2b"/>
    <ellipse cx="226" cy="68" rx="20" ry="7" fill="#c89868" opacity=".6"/>
    <rect x="216" y="50" width="6" height="25" fill="#c8102e"/>
    <circle cx="219" cy="76" r="3.5" fill="#ffd34d"/>
    <g class="nv-leg b"><line x1="238" y1="73" x2="241" y2="98" stroke="#5c3a1a" stroke-width="4.5" stroke-linecap="round"/></g>
    <g class="nv-leg"><line x1="248" y1="72" x2="252" y2="98" stroke="#5c3a1a" stroke-width="4.5" stroke-linecap="round"/></g>
    <path d="M246 54 Q256 44 258 40" stroke="#8b5a2b" stroke-width="12" fill="none" stroke-linecap="round"/>
    <ellipse cx="264" cy="40" rx="12" ry="9" fill="#8b5a2b"/>
    <ellipse cx="256" cy="33" rx="3" ry="5" fill="#6b4220" transform="rotate(-25 256 33)"/>
    <circle cx="262" cy="37" r="1.8" fill="#222"/>
    <circle cx="274" cy="42" r="4.5" fill="#ff2a2a" class="nv-nose"/>
    <path d="M258 31 L254 12 M254 21 L246 17 M254 15 L260 8" stroke="#5c3a1a" stroke-width="3" fill="none" stroke-linecap="round"/>
    <path d="M266 30 L272 12 M272 20 L280 16 M272 14 L267 8" stroke="#5c3a1a" stroke-width="3" fill="none" stroke-linecap="round"/>
  </g>
</svg>`;

let sleighOn = false;
function sendSleigh(){
  if(sleighOn || document.hidden || !layer) return;
  sleighOn = true;
  const c = calc();
  const el = document.createElement('div');
  el.className = 'nv-sleigh';
  el.style.top = (Math.random()*26+8)+'%';
  el.style.animationDuration = CFG.sleighDur+'s';
  el.innerHTML = '<div class="nv-bob"><div class="nv-banner">'+bannerText(c.days)+'</div>'+SLEIGH_SVG+'</div>';
  layer.appendChild(el);
  setTimeout(()=>{el.remove(); sleighOn=false;}, CFG.sleighDur*1000+400);
}
if(!REDUCED){
  setTimeout(sendSleigh, CFG.sleighFirst);
  setInterval(sendSleigh, CFG.sleighEvery);
}

if(!IS_TOUCH && !REDUCED){
  const EM = ['❄','🎄','⭐','🎁','🔔','🎅','❄','🍬'];
  const LEN = 12, dots = [];
  for(let i=0;i<LEN;i++){
    const el = document.createElement('div');
    el.className='nv-t';
    el.textContent = EM[i%EM.length];
    el.style.fontSize = ((1-i/LEN)*15+7).toFixed(0)+'px';
    el.style.opacity = 0;
    document.body.appendChild(el);
    dots.push({el,x:-300,y:-300});
  }
  let mx=-300,my=-300;
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;},{passive:true});
  (function trail(){
    let px=mx,py=my;
    dots.forEach((d,i)=>{
      d.x += (px-d.x)*.35; d.y += (py-d.y)*.35;
      const sc = 1 - i/LEN*.4;
      d.el.style.transform = 'translate('+d.x.toFixed(1)+'px,'+d.y.toFixed(1)+'px) scale('+sc.toFixed(2)+') translate(-50%,-50%)';
      d.el.style.opacity = Math.max(0,(1-i/LEN)*.95).toFixed(2);
      px=d.x; py=d.y;
    });
    requestAnimationFrame(trail);
  })();
}

const MSGS = [
  {i:'🎅', t:'¡JO JO JO!',        g:0},
  {i:'🎄', t:'MERRY CHRISTMAS',   g:1},
  {i:'🔔', t:'¡NAVIDAD!',         g:0},
  {i:'🎶', t:'¡SING SING!',       g:1},
  {i:'🎁', t:'¡FELIZ NAVIDAD!',   g:0},
  {i:'⭐', t:'HO HO HO',          g:1},
  {i:'🦌', t:'¡RUDOLPH!',         g:0},
  {i:'❄', t:'¡FELICES FIESTAS!', g:1}
];
const BURST = ['❄','✨','⭐','🎄','🔔','🎁'];
let mi = 0;

function burst(x,y){
  for(let i=0;i<9;i++){
    const s = document.createElement('span');
    s.textContent = BURST[i%BURST.length];
    s.style.cssText = 'position:fixed;left:'+x+'px;top:'+y+'px;font-size:'+(12+Math.random()*10)+'px;pointer-events:none;z-index:99999;';
    document.body.appendChild(s);
    const a = Math.PI*2*i/9 + Math.random()*.5, d = 45+Math.random()*55;
    const dx = Math.cos(a)*d, dy = Math.sin(a)*d;
    if(s.animate){
      s.animate([
        {transform:'translate(-50%,-50%) scale(1)',opacity:1},
        {transform:'translate(calc(-50% + '+dx+'px),calc(-50% + '+dy+'px)) scale(.4)',opacity:0}
      ],{duration:850,easing:'ease-out'}).onfinish = ()=>s.remove();
    } else { setTimeout(()=>s.remove(),850); }
  }
}

document.addEventListener('click',e=>{
  if(e.target.closest('a,button,input,select,textarea,label,[role=button],#nv-count')) return;
  const m = MSGS[mi++ % MSGS.length];
  const pop = document.createElement('div');
  pop.className = 'nv-pop';
  pop.style.left = Math.min(Math.max(e.clientX-70,8), window.innerWidth-160)+'px';
  pop.style.top  = (e.clientY-30)+'px';
  pop.innerHTML = '<i>'+m.i+'</i><b class="'+(m.g?'g':'')+'">'+m.t+'</b>';
  document.body.appendChild(pop);
  setTimeout(()=>pop.remove(),1950);
  burst(e.clientX,e.clientY);
});

})();
</script>


