}

/* Ceniza ascendente */
function buildAshParticles(parent){
  const COLORS = ['rgba(60,10,80,.6)','rgba(80,20,10,.5)','rgba(40,5,60,.7)','rgba(100,30,10,.4)'];
  let running = true;
  (function spawn(){
    if(!running) return;
    const el = document.createElement('div');
    el.className = 'hw-ash';
    const sz  = (Math.random()*4+2).toFixed(0);
    const dur = (Math.random()*8+8).toFixed(1);
    const ax  = (Math.random()*80-40).toFixed(0)+'px';
    const ax2 = (Math.random()*60-30).toFixed(0)+'px';
    el.style.cssText =
      `width:${sz}px;height:${sz}px;`+
      `background:${COLORS[Math.floor(Math.random()*COLORS.length)]};`+
      `left:${(Math.random()*100).toFixed(1)}%;`+
      `bottom:${(Math.random()*20).toFixed(0)}px;`+
      `animation-duration:${dur}s;--ax:${ax};--ax2:${ax2};`;
    parent.appendChild(el);
    setTimeout(() => el.remove(), dur*1000+300);
    setTimeout(spawn, 600);
  })();
  return () => { running=false; };
}

/* Arañas en hilos */
function buildSpiders(container, zIdx){
  const positions = [6,14,24,36,50,63,75,86,94];
  positions.forEach(xp=>{
    const maxDrop = (Math.random()*42+28).toFixed(0)+'vh';
