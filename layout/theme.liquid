/* ═══════════════════════════════════════════════════════
   ██ PÁGINA PRINCIPAL — Código 1 + Arañas
═══════════════════════════════════════════════════════ */
function initHome(){
  const root = document.getElementById('hw-root');
  root.style.zIndex = '99997';

  /* ── Canvas Partículas + Calabazas + Murciélagos ── */
  const canvas = document.createElement('canvas');
  canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:99997;';
  root.appendChild(canvas);
  const ctx = canvas.getContext('2d');
  let W, H;
  function resize(){ W=canvas.width=window.innerWidth; H=canvas.height=window.innerHeight; }
  window.addEventListener('resize', resize); resize();

  const particles=[], bats=[], pumpkins=[];
  const mouse={x:-100,y:-100};

  function createParticle(x,y,isClick){
    const count = isClick ? 18 : 2;
    for(let i=0;i<count;i++){
      const angle = Math.random()*Math.PI*2;
      const speed = isClick ? Math.random()*6+2 : Math.random()*1.5;
      particles.push({
        x, y,
        vx: isClick ? Math.cos(angle)*speed : (Math.random()-.5)*1.5,
        vy: isClick ? Math.sin(angle)*speed : (Math.random()-.5)*1.5-1,
        size: isClick ? Math.random()*7+3 : Math.random()*5+2,
        color: Math.random()>.4 ? '#ff6600' : (Math.random()>.5 ? '#00ff88' : '#8b00ff'),
        alpha:1, life: isClick ? .025 : .035
      });
    }
  }

  window.addEventListener('mousemove', e=>{
    mouse.x=e.clientX; mouse.y=e.clientY;
    createParticle(mouse.x, mouse.y, false);
  });

  window.addEventListener('click', e=>{
    if(e.target.closest('#hw-cauldron,#hw-home-modal')) return;
    createParticle(e.clientX, e.clientY, true);
    for(let i=0;i<4;i++){
      bats.push({
        x:e.clientX, y:e.clientY,
        vx:(Math.random()-.5)*10, vy:(Math.random()-.8)*8,
        size:Math.random()*12+14, wing:0, alpha:1
      });
    }
    /* ¿Clicó en calabaza? */
    pumpkins.forEach((p,idx)=>{
      if(Math.hypot(e.clientX-p.x,e.clientY-p.y) < p.size){
        createParticle(p.x,p.y,true);
        pumpkins.splice(idx,1);
        openHomeModal();
      }
    });
  });

  /* Calabazas flotantes */
  function spawnPumpkin(){
    if(pumpkins.length < 3){
      pumpkins.push({
        x:Math.random()*(W-100)+50, y:H+50,
        vy:-(Math.random()*1.2+.8), size:32, wobble:0
      });
    }
    setTimeout(spawnPumpkin, Math.random()*4000+3000);
  }
  spawnPumpkin();

  /* Render 60fps */
  function render(){
    ctx.clearRect(0,0,W,H);
    /* partículas */
    for(let i=particles.length-1;i>=0;i--){
      const p=particles[i];
      p.x+=p.vx; p.y+=p.vy; p.alpha-=p.life;
      if(p.alpha<=0){particles.splice(i,1);continue;}
      ctx.save(); ctx.globalAlpha=p.alpha; ctx.fillStyle=p.color;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,Math.PI*2); ctx.fill(); ctx.restore();
    }
    /* murciélagos del click */
    for(let i=bats.length-1;i>=0;i--){
      const b=bats[i];
      b.x+=b.vx; b.y+=b.vy; b.wing+=.25; b.alpha-=.018;
      if(b.alpha<=0){bats.splice(i,1);continue;}
      ctx.save(); ctx.globalAlpha=b.alpha; ctx.fillStyle='#110724';
      ctx.translate(b.x,b.y);
      const wy=Math.sin(b.wing)*7;
      ctx.beginPath();
      ctx.moveTo(0,0);
      ctx.quadraticCurveTo(-b.size/2,-b.size/2+wy,-b.size,0);
      ctx.quadraticCurveTo(-b.size/2,b.size/3,0,0);
      ctx.quadraticCurveTo(b.size/2,-b.size/2+wy,b.size,0);
      ctx.quadraticCurveTo(b.size/2,b.size/3,0,0);
      ctx.fill(); ctx.restore();
    }
    /* calabazas */
    pumpkins.forEach((p,i)=>{
      p.y+=p.vy; p.wobble+=.03; p.x+=Math.sin(p.wobble)*.8;
      ctx.save();
      ctx.font=`${p.size}px serif`; ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.shadowColor='#ff6600'; ctx.shadowBlur=10;
      ctx.fillText('🎃',p.x,p.y); ctx.restore();
      if(p.y<-50) pumpkins.splice(i,1);
    });
    requestAnimationFrame(render);
  }
  render();

  /* ── Caldero ── */
  const cauldron = document.createElement('div');
  cauldron.id = 'hw-cauldron';
  cauldron.innerHTML =
    `<div class="hw-cauldron-glow"></div>`+
    `<div style="font-size:45px;filter:drop-shadow(0 0 10px #ff6600)">🧪</div>`+
    `<div class="hw-tooltip">¡Haz clic para ver la pócima de promocionales!</div>`;
  cauldron.style.pointerEvents='auto';
  document.body.appendChild(cauldron);
  cauldron.addEventListener('click', openHomeModal);

  /* ── Modal ── */
  const modal = document.createElement('div');
  modal.id='hw-home-modal';
  modal.className='hw-modal-overlay';
  modal.style.pointerEvents='auto';
  modal.innerHTML=`
    <div class="hw-modal-box">
      <button class="hw-modal-close" id="hw-close-btn" aria-label="Cerrar">&times;</button>
      <h2>🎃 ¡Descubre la Magia de Halloween!</h2>
      <p>Has liberado los secretos de la temporada. Conoce nuestro catálogo exclusivo de merchandising promocional para tus campañas:</p>
      <a href="https://esferos.com/collections/promocionales" class="hw-modal-link" target="_blank" rel="noopener">Conoce Nuestros Promocionales ➔</a>
    </div>`;
  document.body.appendChild(modal);

  function openHomeModal(){ modal.classList.add('open'); }
  function closeHomeModal(e){ if(e) e.stopPropagation(); modal.classList.remove('open'); }
  document.getElementById('hw-close-btn').addEventListener('click', closeHomeModal);
  document.getElementById('hw-close-btn').addEventListener('touchstart', closeHomeModal);
  modal.addEventListener('click', e=>{ if(e.target===modal) closeHomeModal(e); });

  /* ── Arañas siempre visibles (home) ── */
  const spiderLayer = document.createElement('div');
  spiderLayer.style.cssText='position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:99996;';
  document.body.appendChild(spiderLayer);
  buildSpiders(spiderLayer, 99996);
}

