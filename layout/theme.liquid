        {% endif %}
        {% if settings.font_more_google_link != blank %}
          --custom-font-family: "{{ settings.more_font_family }}", cursive;
        {% endif %}
        
        --primary: {{ settings.color_primary }};
        --primary-2: {{ settings.color_primary_2 }};
