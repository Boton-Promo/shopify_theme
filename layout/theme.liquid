/* ═══════════════════════════════════════════════════════
   ██ PÁGINA PRODUCTO — Código 3 (15s) + Trail cursor
═══════════════════════════════════════════════════════ */
function initProduct(){
  document.body.classList.add('hw-flicker-on');

  /* z-index de animaciones en producto */
  const Z = 2;
  const DURATION = 15000; // 15 s por animación
  const TRANS_MS = 1200;

  /* Elevar imágenes de producto */
  const elevate=()=>{
    const sel=['.product__media-wrapper','.product__media','.product-photo-container',
               '.product-img-wrapper','[data-product-media-type-image]'].join(',');
    document.querySelectorAll(sel).forEach(el=>{el.style.position='relative';el.style.zIndex='10';});
  };
  elevate();
  document.addEventListener('DOMContentLoaded',elevate);

  /* Trail cursor */
  const trailWrap=document.createElement('div');
  trailWrap.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:99998;overflow:hidden;';
  document.body.appendChild(trailWrap);
  buildCursorTrail(trailWrap);

  /* Fantasmas click */
  const ghostWrap=document.createElement('div');
  ghostWrap.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:99999;overflow:hidden;';
  document.body.appendChild(ghostWrap);
  buildClickGhost(ghostWrap);

  /* Capas de animación */
  function makeLayer(id){
    const d=document.createElement(id==='ha-zombies'?'canvas':'div');
    d.id=id;
    d.style.display='none';
    d.style.pointerEvents='none';
    if(id==='ha-zombies'){
      d.style.cssText='display:none;position:fixed;bottom:0;left:0;width:100%;height:130px;pointer-events:none;';
    } else {
      d.style.cssText='display:none;position:fixed;inset:0;overflow:hidden;pointer-events:none;';
    }
    document.body.appendChild(d);
    return d;
  }
  const rainLayer     = makeLayer('ha-rain');
  const demenLayer    = makeLayer('ha-dementors');
  const zombieCanvas  = makeLayer('ha-zombies');
  const spiderLayer   = makeLayer('ha-spiders');

  /* Overlay de transición */
  const overlay=document.createElement('div');
  overlay.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:1000001;background:#050010;clip-path:circle(0% at 50% 50%);transition:clip-path 0s;';
  document.body.appendChild(overlay);

  /* Relámpago */
  const lightDiv=document.createElement('div');
  lightDiv.id='ha-lightning-overlay';
  document.body.appendChild(lightDiv);
  function doLightning(){
    const ld=document.getElementById('ha-lightning-overlay');
    ld.style.transition='opacity .05s'; ld.style.opacity='.9';
    setTimeout(()=>{ld.style.opacity='0';},65);
    setTimeout(()=>{ld.style.opacity='.7';},115);
    setTimeout(()=>{ld.style.opacity='0';},175);
    setTimeout(doLightning,Math.random()*30000+20000);
  }
  setTimeout(doLightning,Math.random()*12000+6000);

  /* ── Controladores de animación ── */
  const cleanups={};

  /* 1. Lluvia */
  function startRain(){
    rainLayer.style.display='block'; rainLayer.style.zIndex=Z;
    const set=['🍬','🎃','👻','🕷️','🦇','💀','🕯️','🍭','🩸','😱','🧟','🪦'];
    const iv=setInterval(()=>{
      const el=document.createElement('span');
      const em=set[Math.floor(Math.random()*set.length)];
      const sz=(Math.random()*22+13).toFixed(0);
      const dur=(Math.random()*3+4).toFixed(1);
      const dr=((Math.random()*140-70)).toFixed(0)+'px';
      const ro=((Math.random()*720-360)).toFixed(0)+'deg';
      el.style.cssText=
        `position:absolute;top:-30px;user-select:none;font-size:${sz}px;`+
        `left:${(Math.random()*96).toFixed(1)}%;`+
        `animation:haFall ${dur}s linear forwards;--d:${dr};--r:${ro};`;
      el.textContent=em;
      rainLayer.appendChild(el);
      setTimeout(()=>el.remove(),dur*1000+200);
    },280);
    cleanups.rain=()=>{clearInterval(iv);rainLayer.querySelectorAll('*').forEach(e=>e.remove());rainLayer.style.display='none';};
  }

  /* 2. Dementores */
  function startDementors(){
    demenLayer.style.display='block'; demenLayer.style.zIndex=Z;
    const active={on:true};
    spawnDementor(demenLayer,active);
    setTimeout(()=>spawnDementor(demenLayer,active),5000);
    cleanups.dementor=()=>{
      active.on=false;
      demenLayer.querySelectorAll('*').forEach(e=>e.remove());
      demenLayer.style.display='none';
    };
  }

  /* 3. Zombies (canvas) */
  function startZombies(){
    const cv=zombieCanvas;
    cv.style.display='block'; cv.style.zIndex=Z;
    const H=130; cv.height=H;
    const resZ=()=>{cv.width=window.innerWidth;};
    resZ(); window.addEventListener('resize',resZ);
    const ctx2=cv.getContext('2d');
    const handsData=[{xr:.12,ph:0,sp:.018,sz:13},{xr:.34,ph:2.1,sp:.022,sz:11},
                     {xr:.54,ph:1.0,sp:.015,sz:14},{xr:.74,ph:3.3,sp:.020,sz:12},{xr:.90,ph:1.7,sp:.016,sz:10}];
    const makeZ=()=>{const W2=cv.width;return Array.from({length:6},(_,i)=>({
      x:Math.random()*W2,dir:i%2===0?1:-1,sp:Math.random()*.45+.25,
      wf:Math.random()*Math.PI*2,sz:Math.random()*10+26}));};
    let zombies=makeZ();
    window.addEventListener('resize',()=>{zombies=makeZ();});
    function dGround(W2){
      const g=ctx2.createLinearGradient(0,0,0,H);
      g.addColorStop(0,'rgba(0,0,0,0)');g.addColorStop(.45,'rgba(4,2,12,.75)');g.addColorStop(1,'rgba(10,5,18,.97)');
      ctx2.fillStyle=g;ctx2.fillRect(0,0,W2,H);
      ctx2.fillStyle='#18080a';ctx2.beginPath();ctx2.moveTo(0,90);
      for(let x=0;x<=W2;x+=15)ctx2.lineTo(x,90+Math.sin(x*.09)*2.5+Math.cos(x*.04)*1.5);
      ctx2.lineTo(W2,H);ctx2.lineTo(0,H);ctx2.closePath();ctx2.fill();
      ctx2.strokeStyle='#2c1010';ctx2.lineWidth=1.5;ctx2.beginPath();ctx2.moveTo(0,90);
      for(let x=0;x<=W2;x+=15)ctx2.lineTo(x,90+Math.sin(x*.09)*2.5+Math.cos(x*.04)*1.5);
      ctx2.stroke();
      ctx2.strokeStyle='#1a2e0a';ctx2.lineWidth=1.2;
      for(let x=10;x<W2;x+=28+Math.round(x*.003)%15){
        const gy=88+Math.sin(x*.09)*2.5;
        ctx2.beginPath();ctx2.moveTo(x,gy);ctx2.lineTo(x-4,gy-7);ctx2.stroke();
        ctx2.beginPath();ctx2.moveTo(x+3,gy);ctx2.lineTo(x+1,gy-8);ctx2.stroke();
      }
    }
    function dTomb(ts){
      ctx2.save();ctx2.translate(ts.x,90);ctx2.rotate(ts.lean);
      ctx2.fillStyle='#342850';ctx2.fillRect(-14,-ts.h,28,ts.h);
      ctx2.beginPath();ctx2.arc(0,-ts.h,14,Math.PI,0);ctx2.fill();
      ctx2.fillStyle='#26183a';ctx2.fillRect(-5,-ts.h+4,8,ts.h*.7);
      if(ts.name==='†'){ctx2.fillStyle='#1e1030';ctx2.fillRect(-2,-ts.h*.78,4,ts.h*.45);ctx2.fillRect(-9,-ts.h*.62,18,4);}
      else{ctx2.fillStyle='#1e1030';ctx2.font='bold 9px serif';ctx2.textAlign='center';ctx2.fillText('RIP',0,-ts.h*.45);}
      ctx2.restore();
    }
    function dHand(hd,t2){
      const rise=Math.max(0,(Math.sin(hd.ph+t2*hd.sp)+1)/2);
      if(rise<.04)return;
      const bY=90-rise*38;const x2=cv.width*hd.xr;
      ctx2.save();ctx2.translate(x2,bY);const s2=hd.sz;
      ctx2.fillStyle='#223a14';ctx2.fillRect(-s2*.28,0,s2*.56,30);
      ctx2.beginPath();ctx2.ellipse(0,-s2*.15,s2*.46,s2*.65,0,0,Math.PI*2);ctx2.fill();
      [[-.38,.9],[-.14,1.05],[.12,1.05],[.36,.88]].forEach(([fx,fl])=>{
        ctx2.fillRect(fx*s2-s2*.11,-s2*.7,s2*.2,fl*s2*.45);
        ctx2.fillStyle='#122208';ctx2.fillRect(fx*s2-s2*.07,-s2*.7-s2*.25,s2*.13,s2*.18);
        ctx2.fillStyle='#223a14';
      });
      ctx2.restore();
    }
   function dZombie(z,t2){
      ctx2.save();ctx2.translate(z.x,90);if(z.dir<0)ctx2.scale(-1,1);
      const s2=z.sz,w2=Math.sin(z.wf),lr=Math.sin(z.wf*.5)*3;
      ctx2.fillStyle='rgba(0,0,0,.35)';ctx2.beginPath();ctx2.ellipse(0,4,s2*.38,3.5,0,0,Math.PI*2);ctx2.fill();
      ctx2.strokeStyle='#1a2e0a';ctx2.lineWidth=s2*.13;ctx2.lineCap='round';
      ctx2.beginPath();ctx2.moveTo(-s2*.1,-s2*.28);ctx2.lineTo(-s2*.18+w2*9,1);ctx2.stroke();
      ctx2.beginPath();ctx2.moveTo(s2*.1,-s2*.28);ctx2.lineTo(s2*.14-w2*9,1);ctx2.stroke();
      ctx2.fillStyle='#1e3010';ctx2.save();ctx2.rotate(.18+lr*.008);
      ctx2.fillRect(-s2*.18,-s2*.92,s2*.38,s2*.62);ctx2.restore();
      ctx2.fillStyle='#2a3e12';ctx2.save();ctx2.rotate(-.14+lr*.015);
      ctx2.beginPath();ctx2.ellipse(s2*.04,-s2*1.02,s2*.2,s2*.22,0,0,Math.PI*2);ctx2.fill();
      ctx2.fillStyle='#44FF00';ctx2.beginPath();ctx2.ellipse(s2*.09,-s2*1.05,2,1.5,0,0,Math.PI*2);ctx2.fill();
      ctx2.restore();
      ctx2.strokeStyle='#1e3010';ctx2.lineWidth=s2*.11;
      ctx2.beginPath();ctx2.moveTo(-s2*.14,-s2*.76);ctx2.lineTo(-s2*.5+w2*6,-s2*.58+w2*3);ctx2.stroke();
      ctx2.beginPath();ctx2.moveTo(s2*.14,-s2*.76);ctx2.lineTo(s2*.62+w2*4,-s2*.58+w2*2);ctx2.stroke();
      ctx2.restore();
    }
    const tombs=()=>{const W2=cv.width;return[
      {x:W2*.08,h:55,lean:-.06,name:'RIP'},{x:W2*.22,h:44,lean:.07,name:'†'},
      {x:W2*.40,h:60,lean:-.03,name:'RIP'},{x:W2*.62,h:48,lean:.08,name:'†'},
      {x:W2*.78,h:52,lean:-.05,name:'RIP'},{x:W2*.92,h:40,lean:.04,name:'†'}];};
    let tZ=0;let rafZ;
    function frameZ(){
      if(cv.style.display==='none')return;
      tZ+=.45;const W2=cv.width;
      ctx2.clearRect(0,0,W2,H);
      dGround(W2);tombs().forEach(dTomb);
      handsData.forEach(hd=>dHand(hd,tZ));
      zombies.forEach(z=>{
        z.x+=z.sp*z.dir;z.wf+=.058*z.sp*3.5;
        if(z.x>W2+70)z.x=-70;if(z.x<-70)z.x=W2+70;
        dZombie(z,tZ);
      });
      rafZ=requestAnimationFrame(frameZ);
    }
    frameZ();
    cleanups.zombie=()=>{
      cancelAnimationFrame(rafZ);
      window.removeEventListener('resize',resZ);
      ctx2.clearRect(0,0,cv.width,H);
      cv.style.display='none';
    };
  }

  /* 4. Arañas */
  function startSpiders(){
    spiderLayer.style.display='block'; spiderLayer.style.zIndex=Z;
    buildSpiders(spiderLayer, Z);
    cleanups.spider=()=>{spiderLayer.innerHTML='';spiderLayer.style.display='none';};
  }

  /* ── Transiciones ── */
  const TRANS=[
    {bg:'#050010',inP:'circle(150% at 50% 50%)',outP:'circle(0% at 50% 50%)'},
    {bg:'#0a0502',inP:'polygon(0 100%,100% 100%,100% 0%,0 0%)',outP:'polygon(0 100%,100% 100%,100% 100%,0 100%)'},
    {bg:'#050010',inP:'circle(160% at 0% 0%)',outP:'circle(0% at 0% 0%)'},
    {bg:'#060410',inP:'polygon(50% 0%,100% 0%,100% 100%,0% 100%,0% 0%)',outP:'circle(0% at 50% 50%)'},
  ];
  function doTrans(fromIdx,mid){
    const cfg=TRANS[fromIdx%TRANS.length];
    overlay.style.background=cfg.bg;overlay.style.zIndex='1000001';
    overlay.style.transition=`clip-path ${TRANS_MS/2}ms ease-in`;
    overlay.style.clipPath=cfg.inP;
    setTimeout(()=>{
      mid();
      overlay.style.transition=`clip-path ${TRANS_MS/2}ms ease-out`;
      overlay.style.clipPath=cfg.outP;
    },TRANS_MS/2);
  }

  /* ── Rotación ── */
  const ORDER=['rain','dementor','zombie','spider'];
  const STARTERS={rain:startRain,dementor:startDementors,zombie:startZombies,spider:startSpiders};
  let cur=0;
  STARTERS[ORDER[0]]();
  setInterval(()=>{
    const from=cur;
    cur=(cur+1)%ORDER.length;
    doTrans(from,()=>{
      if(cleanups[ORDER[from]])cleanups[ORDER[from]]();
      STARTERS[ORDER[cur]]();
    });
  },DURATION);
}

/* ═══════════════════════════════════════════════════════
   EJECUTAR SEGÚN PÁGINA
═══════════════════════════════════════════════════════ */
if(IS_HOME)        initHome();
else if(IS_COLL)   initCollection();
else if(IS_PROD)   initProduct();

